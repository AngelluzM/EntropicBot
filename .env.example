DISCORD_TOKEN=replace-with-your-discord-bot-token

# Optional: sync slash commands instantly to one Discord server during development.
# Leave empty in production if you want global commands.
DISCORD_GUILD_ID=

# Optional: where the bot reads the systems/actions configuration.
SYSTEMS_CONFIG_PATH=systems.json

# Optional: local JSON file where Discord user <-> character sheet links are cached.
SHEETS_STORE_PATH=data/character_sheets.json

# Optional: local JSON file where registered RPG players are stored.
PLAYERS_STORE_PATH=data/players.json

# Optional: comma-separated Discord role IDs allowed to use staff commands.
# If empty, users with Manage Server permission can use staff commands.
DISCORD_STAFF_ROLE_IDS=

# Optional: daily sheet sync interval. Keep 24 in production.
SHEET_SYNC_INTERVAL_HOURS=24

# Example tokens used by systems.example.json.
AEPHIRUM_API_TOKEN=replace-with-your-aephirum-api-token
SECOND_RPG_API_TOKEN=replace-with-your-second-system-api-token
